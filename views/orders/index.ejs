<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Orders | Donut House</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;600;700;800;900&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body>

    <%- include('../partials/_navbar.ejs') %>

        <main class="my-orders-page">

            <div class="container">

                <!-- PAGE HEADER -->

                <div class="orders-header">

                    <h1>
                        My Orders
                    </h1>

                    <p>
                        View your previous Donut House orders.
                    </p>

                </div>




                <% if (orders.length===0) { %>

                    <!-- EMPTY -->

                    <section class="my-orders-empty">

                        <h2>
                            No orders yet
                        </h2>

                        <p>
                            You haven't placed any orders yet.
                        </p>

                        <a href="/donuts" class="my-orders-button">
                            Start Shopping
                        </a>

                    </section>


                    <% } else { %>

                        <!-- ORDERS -->

                        <div class="my-orders-list">

                            <% orders.forEach(order=> { %>

                                <article class="my-order-card">

                                    <!-- TOP -->

                                    <div class="my-order-top">

                                        <div>

                                            <span class="my-order-label">
                                                ORDER
                                            </span>

                                            <h2>
                                                #<%= order._id %>
                                            </h2>

                                        </div>

                                        <span class="my-order-status">
                                            <%= order.status %>
                                        </span>

                                    </div>


                                    <!-- INFORMATION -->

                                    <div class="my-order-info">

                                        <div class="my-order-info-row">

                                            <span>
                                                Total
                                            </span>

                                            <strong>
                                                BD <%= order.total.toFixed(3) %>
                                            </strong>

                                        </div>


                                        <div class="my-order-info-row">

                                            <span>
                                                Date
                                            </span>

                                            <strong>
                                                <%= order.createdAt.toLocaleDateString() %>
                                            </strong>

                                        </div>

                                    </div>


                                    <!-- BUTTON -->

                                    <div class="my-order-action">

                                        <a href="/orders/<%= order._id %>" class="my-orders-button">

                                            View Order

                                        </a>

                                    </div>

                                </article>

                                <% }) %>

                        </div>

                        <% } %>

            </div>

        </main>


        <%- include('../partials/_footer.ejs') %>

</body>

</html>