<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Order Details | Donut House</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;600;700;800;900&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body>

    <%- include('../partials/_navbar.ejs') %>


        <!-- =========================
         ORDER DETAILS
    ========================== -->

        <main class="order-details-page">

            <div class="container">

                <!-- PAGE TITLE -->

                <div class="order-details-header">


                    <h1 class="sectionTitle">
                        Order Details
                    </h1>

                </div>


                <!-- ORDER CARD -->

                <div class="cardBase order-details-card">

                    <!-- ORDER NUMBER -->

                    <div class="order-heading">

                        <h2>
                            Order #<%= order._id %>
                        </h2>

                        <span class="order-status">
                            <%= order.status %>
                        </span>

                    </div>


                    <!-- ORDER INFORMATION -->

                    <div class="order-info">

                        <div class="order-info-row">

                            <span class="order-info-label">
                                Status
                            </span>

                            <strong>
                                <%= order.status %>
                            </strong>

                        </div>


                        <div class="order-info-row">

                            <span class="order-info-label">
                                Pickup Location
                            </span>

                            <strong>
                                <%= order.location ? order.location.name : 'Location no longer available' %>
                            </strong>

                        </div>

                    </div>


                    <hr>


                    <!-- ITEMS -->

                    <h2 class="order-items-title">
                        Items
                    </h2>


                    <div class="order-items">

                        <% order.items.forEach(item=> { %>

                            <div class="order-item">

                                <div class="order-item-info">

                                    <h3>
                                        <%= item.donut ? item.donut.name : 'Donut no longer available' %>
                                    </h3>


                                    <p>
                                        Quantity:

                                        <strong>
                                            <%= item.quantity %>
                                        </strong>
                                    </p>


                                    <p>
                                        Price:

                                        <strong>
                                            BD <%= Number(item.price).toFixed(3) %>
                                        </strong>
                                    </p>

                                </div>


                                <div class="order-item-subtotal">

                                    <span>
                                        Subtotal
                                    </span>

                                    <strong>
                                        BD <%= ( Number(item.price) * Number(item.quantity) ).toFixed(3) %>
                                    </strong>

                                </div>

                            </div>

                            <% }) %>

                    </div>


                    <hr>


                    <!-- TOTAL -->

                    <div class="order-total">

                        <span>
                            Total
                        </span>

                        <strong>
                            BD <%= Number(order.total).toFixed(3) %>
                        </strong>

                    </div>


                    <!-- BACK BUTTON -->

                    <div class="order-actions">

                        <a href="/orders" class="order-back-button">
                            Back to My Orders
                        </a>

                    </div>

                </div>

            </div>

        </main>


        <%- include('../partials/_footer.ejs') %>

</body>

</html>