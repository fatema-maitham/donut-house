<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Manage Orders | Donut House</title>

    <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body>

    <%- include('../partials/_navbar.ejs') %>

        <main>

            <section class="section">

                <div class="container">

                    <h1 class="sectionTitle">
                        Manage Orders
                    </h1>

                    <% if (orders.length===0) { %>

                        <p>No orders yet.</p>

                        <% } else { %>

                            <% orders.forEach(order=> { %>

                                <div class="cardBase" style="position: relative; margin-bottom: 20px;">

                                    <h2>
                                        Order #<%= order._id %>
                                    </h2>

                                    <p>
                                        Customer:
                                        <%= order.user.username %>
                                    </p>

                                    <p>
                                        Location:
                                        <%= order.location.name %>
                                    </p>

                                    <p>
                                        Total:
                                        BD <%= order.total.toFixed(3) %>
                                    </p>

                                    <p>
                                        Status:
                                        <%= order.status %>
                                    </p>

                                    <br>

                                    <a href="/orders/<%= order._id %>">
                                        View Order
                                    </a>

                                </div>

                                <% }) %>

                                    <% } %>

                </div>

            </section>

        </main>

        <%- include('../partials/_footer.ejs') %>

</body>

</html>