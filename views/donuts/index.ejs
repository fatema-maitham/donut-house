<% donuts.forEach((donut)=> { %>

    <div>
        <h2>
            <a href="/donuts/<%= donut._id %>">
                <%= donut.name %>
            </a>
        </h2>

        <img src="<%= donut.image %>" alt="<%= donut.name %>" width="200">

        <p>
            <%= donut.description %>
        </p>

        <p>Price: <%= donut.price %>
        </p>

        <p>Category: <%= donut.category %>
        </p>
    </div>

    <% }) %>