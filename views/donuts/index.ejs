<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Donut House</title>
</head>

<body>

    <%- include('../partials/_navbar.ejs') %>

        <h1>Our Donuts 🍩</h1>

        <% donuts.forEach((donut)=> { %>

            <div>
                <h2>
                    <a href="/donuts/<%= donut._id %>">
                        <%= donut.name %>
                    </a>
                </h2>

                <p>
                    <%= donut.description %>
                </p>

                <p>Price: <%= donut.price %>
                </p>

                <p>Category: <%= donut.category %>
                </p>

            </div>

            <% }) %>

                <%- include('../partials/_footer.ejs') %>

</body>

</html>