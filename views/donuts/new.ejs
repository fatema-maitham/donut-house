<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Add Donut - Donut House</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;600;700;800;900&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="/stylesheets/style.css">

</head>

<body>

    <div class="admin-layout">

        <%- include('../partials/_adminSidebar.ejs') %>

            <main class="admin-content">

                <div class="admin-form-card">

                    <h1>Add Donut</h1>

                    <p class="admin-form-subtitle">
                        Add a new donut to the Donut House menu.
                    </p>

                    <form action="/donuts" method="POST" enctype="multipart/form-data" class="admin-form">

                        <label for="name">
                            Donut Name
                        </label>

                        <input type="text" id="name" name="name" placeholder="e.g. Boston Cream" required>


                        <label for="description">
                            Description
                        </label>

                        <textarea id="description" name="description" placeholder="Describe the donut..." rows="5"
                            required></textarea>


                        <label for="price">
                            Price
                        </label>

                        <input type="number" id="price" name="price" step="0.001" min="0" placeholder="1.560" required>


                        <label for="category">
                            Category
                        </label>

                        <select id="category" name="category" required>

                            <option value="">
                                Select category
                            </option>

                            <option value="classic">
                                Classic Donut
                            </option>

                            <option value="special">
                                Special Donut
                            </option>

                            <option value="box">
                                Box Deal
                            </option>

                        </select>


                        <label for="image">
                            Donut Image
                        </label>

                        <input type="file" id="image" name="image" accept="image/jpeg,image/png,image/webp" required>


                        <label for="available">
                            Availability
                        </label>

                        <select id="available" name="available">

                            <option value="true">
                                Available
                            </option>

                            <option value="false">
                                Not Available
                            </option>

                        </select>


                        <button type="submit" class="admin-button">
                            Add Donut
                        </button>

                    </form>

                </div>

            </main>

    </div>

    <%- include('../partials/_footer.ejs') %>

</body>

</html>