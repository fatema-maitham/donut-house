<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        <%= donut.name %> | Donut House
    </title>
</head>

<body>

    <%- include('../partials/_navbar.ejs') %>

        <main>

            <h1>
                <%= donut.name %>
            </h1>

            <img src="<%= donut.image %>" alt="<%= donut.name %>" width="300">

            <p>
                <%= donut.description %>
            </p>

            <p>
                Price: <%= donut.price %>
            </p>

            <p>
                Category: <%= donut.category %>
            </p>

            <% if (donut.available) { %>

                <p>Available 🍩</p>

                <% } else { %>

                    <p>Currently unavailable</p>

                    <% } %>


                        <!-- CUSTOMER: ADD TO CART -->

                        <% if (user && user.role==='customer' && donut.available) { %>

                            <form action="/cart/add/<%= donut._id %>" method="POST">

                                <button type="submit">
                                    Add to Cart 🛒
                                </button>

                            </form>

                            <% } %>


                                <!-- ADMIN ACTIONS -->

                                <% if (user && user.role==='admin' ) { %>

                                    <hr>

                                    <h2>Admin Actions</h2>

                                    <a href="/donuts/<%= donut._id %>/edit">
                                        Edit Donut
                                    </a>

                                    <br><br>

                                    <form action="/donuts/<%= donut._id %>?_method=DELETE" method="POST">

                                        <button type="submit">
                                            Delete Donut
                                        </button>

                                    </form>

                                    <% } %>


                                        <br>

                                        <a href="/donuts">
                                            Back to Donuts
                                        </a>

        </main>

        <%- include('../partials/_footer.ejs') %>

</body>

</html>