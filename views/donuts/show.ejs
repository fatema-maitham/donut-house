<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        <%= donut.name %> | Donut House
    </title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;600;700;800;900&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="/stylesheets/style.css">

</head>

<body>

    <%- include('../partials/_navbar.ejs') %>

        <main>

            <section class="donut-show-section">

                <div class="container">

                    <!-- BACK TO MENU -->

                    <a href="/donuts" class="donut-back-menu">
                        ← Back to Menu
                    </a>


                    <!-- DONUT DETAILS -->

                    <div class="donut-show-grid">

                        <!-- IMAGE -->

                        <div class="donut-show-image">

                            <img src="<%= donut.image %>" alt="<%= donut.name %>">

                        </div>


                        <!-- DETAILS -->

                        <div class="donut-show-details">

                            <div class="donut-show-category">
                                <%= donut.category %>
                            </div>

                            <h1>
                                <%= donut.name %>
                            </h1>

                            <div class="donut-show-price">
                                BD <%= Number(donut.price).toFixed(3) %>
                            </div>

                            <p class="donut-show-description">
                                <%= donut.description %>
                            </p>


                            <% if (user) { %>

                                <form action="/cart/add/<%= donut._id %>" method="POST" class="donut-add-form">

                                    <button type="submit" class="donut-add-button">
                                        Add to Cart
                                    </button>

                                </form>

                                <% } else { %>

                                    <div class="donut-login-message">

                                        Please log in to add this donut to your cart.

                                        <a href="/auth/login">
                                            Login
                                        </a>

                                    </div>

                                    <% } %>

                        </div>

                    </div>

                </div>

            </section>

        </main>

        <%- include('../partials/_footer.ejs') %>

</body>

</html>