<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        <%= donut.name %> | Donut House
    </title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;600;700;800;900&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body>

    <%- include('../partials/_navbar.ejs') %>

        <main>

            <section class="infoSection">

                <div class="container">

                    <div class="infoBlock">

                        <!-- Donut Image -->
                        <div class="infoImg">

                            <img src="<%= donut.image %>" alt="<%= donut.name %>">

                        </div>


                        <!-- Donut Information -->
                        <div>

                            <h2>
                                <%= donut.name %>
                            </h2>

                            <p>
                                <strong>Category:</strong>
                                <%= donut.category %>
                            </p>

                            <p>
                                <strong>Price:</strong>
                                BD <%= donut.price.toFixed(3) %>
                            </p>

                            <p style="margin-top: 14px;">
                                <%= donut.description %>
                            </p>


                            <% if (user) { %>

                                <form action="/cart/add/<%= donut._id %>" method="POST" style="margin-top: 24px;">

                                    <button type="submit">
                                        Add to Cart
                                    </button>

                                </form>

                                <% } else { %>

                                    <p style="margin-top: 24px;">
                                        Please log in to add items to your cart.
                                    </p>

                                    <a href="/auth/login">
                                        Login
                                    </a>

                                    <% } %>


                                        <br>

                                        <a href="/donuts">
                                            Back to Menu
                                        </a>

                        </div>

                    </div>

                </div>

            </section>

        </main>

        <%- include('../partials/_footer.ejs') %>

</body>

</html>