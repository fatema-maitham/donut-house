<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Cart | Donut House</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;600;700;800;900&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body>

    <%- include('../partials/_navbar.ejs') %>


        <main>

            <section class="section">

                <div class="container">

                    <h1 class="sectionTitle">
                        Your Cart
                    </h1>


                    <% if (!user.cart || user.cart.length===0) { %>

                        <p>Your cart is empty.</p>

                        <br>

                        <a href="/donuts">
                            Continue Shopping
                        </a>

                        <% } else { %>


                            <% let total=0; %>


                                <% user.cart.forEach(item=> { %>

                                    <% if (item.donutId) { %>

                                        <% const itemTotal=item.donutId.price * item.quantity; %>

                                            <% total +=itemTotal; %>


                                                <div class="cardBase" style="position: relative; margin-bottom: 20px;">

                                                    <div class="metaRow">

                                                        <div>

                                                            <div class="name">
                                                                <%= item.donutId.name %>
                                                            </div>

                                                            <small>
                                                                BD <%= item.donutId.price.toFixed(3) %>
                                                                    each
                                                            </small>

                                                        </div>


                                                        <div>

                                                            <strong>
                                                                BD <%= itemTotal.toFixed(3) %>
                                                            </strong>

                                                        </div>

                                                    </div>


                                                    <!-- Quantity -->
                                                    <div style="margin-top: 15px;">

                                                        <strong>
                                                            Quantity:
                                                        </strong>

                                                        <a href="/cart/decrease/<%= item.donutId._id %>">
                                                            −
                                                        </a>

                                                        <span style="margin: 0 15px;">
                                                            <%= item.quantity %>
                                                        </span>

                                                        <a href="/cart/increase/<%= item.donutId._id %>">
                                                            +
                                                        </a>

                                                    </div>


                                                    <!-- Remove -->
                                                    <form action="/cart/remove/<%= item.donutId._id %>" method="POST"
                                                        style="margin-top: 15px;">

                                                        <button type="submit">
                                                            Remove
                                                        </button>

                                                    </form>

                                                </div>

                                                <% } %>

                                                    <% }) %>


                                                        <!-- Total -->
                                                        <div style="margin-top: 30px;">

                                                            <h2>
                                                                Total:
                                                                BD <%= total.toFixed(3) %>
                                                            </h2>

                                                            <br>

                                                            <a href="/donuts">
                                                                Continue Shopping
                                                            </a>

                                                            <br><br>

                                                            <a href="/orders/new">
                                                                Checkout
                                                            </a>

                                                        </div>


                                                        <% } %>

                </div>

            </section>

        </main>


        <%- include('../partials/_footer.ejs') %>

</body>

</html>