<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Your Cart | Donut House</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;600;700;800;900&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="/stylesheets/style.css">

</head>


<body>

    <%- include('../partials/_navbar.ejs') %>


        <main class="cart-page">

            <div class="container">

                <!-- PAGE HEADER -->

                <div class="cart-page-header">

                    <h1>
                        Your Cart
                    </h1>

                </div>


                <% if (!cart || cart.length===0) { %>

                    <!-- EMPTY CART -->

                    <section class="empty-cart">

                        <h2>
                            Your Cart is Empty
                        </h2>

                        <a href="/donuts" class="cart-browse-button">

                            Browse Donuts

                        </a>

                    </section>


                    <% } else { %>

                        <!-- CART -->

                        <div class="cart-layout">

                            <div class="cart-list">

                                <% let total=0; %>


                                    <% cart.forEach(item=> { %>

                                        <% if (item.donutId) { %>

                                            <% const donut=item.donutId; %>

                                                <% const itemTotal=donut.price * item.quantity; %>

                                                    <% total +=itemTotal; %>


                                                        <article class="cart-item">

                                                            <!-- IMAGE -->

                                                            <div class="cart-image">

                                                                <img src="<%= donut.image %>" alt="<%= donut.name %>">

                                                            </div>


                                                            <!-- INFO -->

                                                            <div class="cart-info">

                                                                <h2>
                                                                    <%= donut.name %>
                                                                </h2>

                                                                <p>
                                                                    BD <%= donut.price.toFixed(3) %>
                                                                </p>


                                                                <div class="cart-quantity">

                                                                    <a href="/cart/decrease/<%= donut._id %>"
                                                                        class="quantity-button">

                                                                        −

                                                                    </a>


                                                                    <span>
                                                                        <%= item.quantity %>
                                                                    </span>


                                                                    <a href="/cart/increase/<%= donut._id %>"
                                                                        class="quantity-button">

                                                                        +

                                                                    </a>

                                                                </div>

                                                            </div>


                                                            <!-- RIGHT -->

                                                            <div class="cart-item-right">

                                                                <div class="cart-item-price">

                                                                    BD
                                                                    <%= itemTotal.toFixed(3) %>

                                                                </div>


                                                                <a href="/cart/remove/<%= donut._id %>"
                                                                    class="remove-button">

                                                                    Remove

                                                                </a>

                                                            </div>

                                                        </article>

                                                        <% } %>

                                                            <% }) %>

                            </div>


                            <!-- SUMMARY -->

                            <aside class="cart-summary">

                                <div class="summary-row">

                                    <span>
                                        Total
                                    </span>

                                    <strong>
                                        BD <%= total.toFixed(3) %>
                                    </strong>

                                </div>


                                <a href="/orders/new" class="checkout-button">

                                    Checkout

                                </a>

                            </aside>

                        </div>

                        <% } %>

            </div>

        </main>


        <%- include('../partials/_footer.ejs') %>

</body>

</html>