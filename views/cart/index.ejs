<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Your Cart | Donut House</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;600;700;800;900&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="/stylesheets/style.css">
</head>


<body>

    <%- include('../partials/_navbar.ejs') %>


        <main>

            <div class="container">

                <div class="menuIntro">

                    <div class="menuIntroTitle">
                        Your Cart
                    </div>

                    <p class="menuIntroText">
                        Your donut order is waiting for you!
                    </p>

                </div>


                <% if (!cart || cart.length===0) { %>

                    <div class="emptyCart">

                        <h2>
                            Your cart is empty 🍩
                        </h2>

                        <p>
                            Add some delicious donuts to your order.
                        </p>

                        <a href="/donuts" class="cartButton">
                            Browse Donuts
                        </a>

                    </div>

                    <% } else { %>


                        <div class="cartList">

                            <% let total=0; %>


                                <% cart.forEach(item=> { %>

                                    <% if (item.donutId) { %>

                                        <% const donut=item.donutId; const itemTotal=donut.price * item.quantity; total
                                            +=itemTotal; %>


                                            <article class="cartItem">

                                                <div class="cartImage">

                                                    <img src="<%= donut.image %>" alt="<%= donut.name %>">

                                                </div>


                                                <div class="cartInfo">

                                                    <h2>
                                                        <%= donut.name %>
                                                    </h2>

                                                    <p>
                                                        BD <%= donut.price.toFixed(3) %>
                                                    </p>


                                                    <div class="cartQuantity">

                                                        <a href="/cart/decrease/<%= donut._id %>"
                                                            class="quantityButton">
                                                            −
                                                        </a>


                                                        <span>
                                                            <%= item.quantity %>
                                                        </span>


                                                        <a href="/cart/increase/<%= donut._id %>"
                                                            class="quantityButton">
                                                            +
                                                        </a>

                                                    </div>

                                                </div>


                                                <div class="cartItemRight">

                                                    <div class="cartItemPrice">
                                                        BD <%= itemTotal.toFixed(3) %>
                                                    </div>


                                                    <a href="/cart/remove/<%= donut._id %>" class="removeButton">
                                                        Remove
                                                    </a>

                                                </div>

                                            </article>

                                            <% } %>

                                                <% }) %>

                        </div>


                        <div class="cartSummary">

                            <div class="summaryRow">

                                <span>
                                    Total
                                </span>

                                <strong>
                                    BD <%= total.toFixed(3) %>
                                </strong>

                            </div>


                            <a href="/orders/new" class="checkoutButton">
                                Checkout
                            </a>

                        </div>


                        <% } %>

            </div>

        </main>


        <%- include('../partials/_footer.ejs') %>

</body>

</html>