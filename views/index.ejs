<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Donut House</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;600;700;800;900&display=swap"
    rel="stylesheet">

  <link rel="stylesheet" href="/stylesheets/style.css">

</head>

<body>

  <%- include('./partials/_navbar.ejs') %>


    <main>


      <!-- =========================
         HERO
    ========================== -->

      <header class="hero home-hero">

        <div class="container">

          <div class="heroCard">

            <h1 class="heroTitle">
              Donuts, But Better.
            </h1>

            <p class="heroSub">
              Freshly baked. Fully plant-based. Made to crave.
            </p>

            <a href="/donuts" class="home-primary-button">
              View Menu
            </a>

          </div>

        </div>

      </header>


      <!-- =========================
         MOST POPULAR
    ========================== -->

      <section class="home-popular">

        <div class="container">

          <div class="home-section-header">

            <div>

              <h2>
                Most Popular
              </h2>

              <p>
                The donuts our customers keep coming back for.
              </p>

            </div>

            <a href="/donuts" class="home-view-all">
              View All
            </a>

          </div>


          <% if (donuts && donuts.length> 0) { %>

            <div class="home-popular-grid">

              <% donuts.slice(0, 3).forEach(donut=> { %>

                <article class="home-popular-card">

                  <!-- DONUT IMAGE -->

                  <a href="/donuts/<%= donut._id %>" class="home-popular-image" aria-label="View <%= donut.name %>">

                    <% if (donut.image) { %>

                      <img src="<%= donut.image %>" alt="<%= donut.name %>">

                      <% } %>

                  </a>


                  <!-- CARD -->

                  <div class="home-popular-base">

                    <div class="home-popular-meta">

                      <span>
                        <%= donut.category %>
                      </span>

                    </div>


                    <a href="/donuts/<%= donut._id %>" class="home-popular-name">
                      <%= donut.name %>
                    </a>


                    <div class="home-popular-bottom">

                      <span class="home-popular-price">
                        BD <%= Number(donut.price).toFixed(3) %>
                      </span>


                      <form action="/cart/add/<%= donut._id %>" method="POST" class="add-to-cart-form">

                        <button type="submit" class="add-to-cart-btn" aria-label="Add <%= donut.name %> to cart"
                          data-donut-image="<%= donut.image %>">

                          <img src="/images/cart.png" alt="">
                        </button>

                      </form>



                    </div>

                  </div>

                </article>

                <% }) %>

            </div>


            <% } else { %>

              <div class="home-no-donuts">

                <h3>
                  Our donuts are coming soon.
                </h3>

                <p>
                  Check out our menu to see what's available.
                </p>

                <a href="/donuts" class="home-primary-button">
                  View Menu
                </a>

              </div>

              <% } %>

        </div>

      </section>


      <!-- =========================
         SPECIAL DONUTS
    ========================== -->

      <section class="home-special">

        <div class="container">

          <div class="home-section-header">

            <div>

              <h2>
                Special Donuts
              </h2>

              <p>
                Limited-time flavors made to make your day a little sweeter.
              </p>

            </div>



          </div>


          <% const specialDonuts=donuts ? donuts.filter(donut=>
            donut.category === 'special'
            ).slice(0, 3)
            : [];
            %>


            <% if (specialDonuts.length> 0) { %>

              <div class="home-popular-grid">

                <% specialDonuts.forEach(donut=> { %>

                  <article class="home-popular-card">

                    <!-- IMAGE -->

                    <a href="/donuts/<%= donut._id %>" class="home-popular-image" aria-label="View <%= donut.name %>">

                      <% if (donut.image) { %>

                        <img src="<%= donut.image %>" alt="<%= donut.name %>">

                        <% } %>

                    </a>


                    <!-- CARD -->

                    <div class="home-popular-base">

                      <div class="home-popular-meta">

                        <span>
                          Monthly Special
                        </span>

                      </div>


                      <a href="/donuts/<%= donut._id %>" class="home-popular-name">
                        <%= donut.name %>
                      </a>


                      <div class="home-popular-bottom">

                        <span class="home-popular-price">
                          BD <%= Number(donut.price).toFixed(3) %>
                        </span>


                        <form action="/cart/add/<%= donut._id %>" method="POST" class="add-to-cart-form">

                          <button type="submit" class="add-to-cart-btn" aria-label="Add <%= donut.name %> to cart">

                            <img src="/images/cart.png" alt="">

                          </button>

                        </form>

                      </div>

                    </div>

                  </article>

                  <% }) %>

              </div>


              <% } else { %>

                <div class="home-no-donuts">

                  <h3>
                    New specials are coming soon.
                  </h3>

                  <p>
                    Check back soon for our latest limited-time donuts.
                  </p>

                  <a href="/donuts" class="home-primary-button">
                    View Menu
                  </a>

                </div>

                <% } %>

        </div>

      </section>


      <!-- =========================
         CUSTOMER REVIEWS
    ========================== -->

      <section class="home-reviews">

        <div class="container">

          <div class="home-reviews-header">

            <h2>
              What Our Customers Say
            </h2>

            <p>
              Sweet words from our donut lovers.
            </p>

          </div>


          <div class="home-review-grid">

            <article class="home-review-card">

              <div class="home-review-stars">
                ★★★★★
              </div>

              <p class="home-review-text">
                “The best donuts I’ve ever had! So fresh, soft, and delicious.”
              </p>

              <div class="home-review-name">
                - Sayed Mohammed
              </div>

            </article>


            <article class="home-review-card">

              <div class="home-review-stars">
                ★★★★★
              </div>

              <p class="home-review-text">
                “I’m obsessed with the flavors. You can really taste how fresh they are!”
              </p>

              <div class="home-review-name">
                - Hassan
              </div>

            </article>


            <article class="home-review-card">

              <div class="home-review-stars">
                ★★★★★
              </div>

              <p class="home-review-text">
                “The perfect treat with my coffee. I’ll definitely be ordering again.”
              </p>

              <div class="home-review-name">
                - Zainab
              </div>

            </article>

          </div>

        </div>

      </section>


      <!-- =========================
         ABOUT
    ========================== -->

      <section class="home-about">

        <div class="container">

          <div class="home-about-content">

            <h2>
              A better kind of donut.
            </h2>

            <p>
              At Donut House, we believe donuts should be delicious,
              fresh, and made with better ingredients.
            </p>



          </div>

        </div>

      </section>


    </main>


    <%- include('./partials/_footer.ejs') %>

      <script src="/javascripts/card-flip.js"></script>
      <script src="/javascripts/cart-animation.js"></script>
</body>

</html>