<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        <%= location.name %> | Donut House
    </title>
</head>

<body>

    <%- include('../partials/_navbar.ejs') %>

        <h1>
            <%= location.name %>
        </h1>

        <h2>📍 Location Details</h2>

        <p>
            <strong>Address:</strong>
            <%= location.address %>
        </p>

        <p>
            <strong>City:</strong>
            <%= location.city %>
        </p>

        <p>
            <strong>Phone:</strong>
            <%= location.phone %>
        </p>

        <p>
            <strong>Opening Hours:</strong>
            <%= location.openingHours %>
        </p>

        <% if (location.available) { %>

            <p>
                Currently Open
            </p>

            <% } else { %>

                <p>
                    Currently Unavailable
                </p>

                <% } %>

                    <br>

                    <a href="/locations">
                        Back to Locations
                    </a>
                    <% if (user && user.role==='admin' ) { %>

                        <a href="/locations/<%= location._id %>/edit">
                            Edit Location
                        </a>

                        <form action="/locations/<%= location._id %>?_method=DELETE" method="POST">
                            <button type="submit">
                                Delete Location
                            </button>
                        </form>

                        <% } %>
                            <%- include('../partials/_footer.ejs') %>

</body>

</html>