<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        <%= location.name %> | Donut House
    </title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;600;700;800;900&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="/stylesheets/style.css">

</head>


<body>


    <% if (user && user.role==='admin' ) { %>

        <!-- ============================================
         ADMIN VIEW
    ============================================ -->

        <div class="admin-layout">

            <%- include('../partials/_adminSidebar.ejs') %>


                <main class="admin-content">

                    <!-- PAGE HEADER -->

                    <div class="admin-page-header">

                        <div>

                            <h1>
                                <%= location.name %>
                            </h1>

                            <p>
                                View and manage this pickup location.
                            </p>

                        </div>

                    </div>


                    <!-- LOCATION CARD -->

                    <article class="simple-location-show-card">

                        <div class="simple-location-show-top">

                            <h2>
                                <%= location.name %>
                            </h2>

                            <span class="location-status location-status-js" data-opening="<%= location.openingTime %>"
                                data-closing="<%= location.closingTime %>">
                            </span>

                        </div>


                        <!-- INFORMATION -->

                        <div class="simple-location-show-info">

                            <div>

                                <span>
                                    Address
                                </span>

                                <strong>
                                    <%= location.address %>,
                                        <%= location.city %>
                                </strong>

                            </div>


                            <div>

                                <span>
                                    Opening Hours
                                </span>

                                <strong>
                                    <%= location.openingTime %>
                                        –
                                        <%= location.closingTime %>
                                </strong>

                            </div>


                            <div>

                                <span>
                                    Phone
                                </span>

                                <strong>
                                    <%= location.phone %>
                                </strong>

                            </div>

                        </div>


                        <!-- ADMIN ACTIONS -->

                        <div class="simple-location-show-actions">

                            <a href="/locations/<%= location._id %>/edit" class="simple-location-edit"> Edit Location
                            </a>


                            <form action="/locations/<%= location._id %>?_method=DELETE" method="POST"
                                onsubmit="return confirm('Are you sure you want to delete this location?');">

                                <button type="submit" class="simple-location-delete">

                                    Delete Location

                                </button>

                            </form>

                        </div>

                    </article>

                </main>

        </div>


        <% } else { %>


            <!-- ============================================
         CUSTOMER / ANONYMOUS VIEW
    ============================================ -->

            <%- include('../partials/_navbar.ejs') %>


                <main class="simple-location-show-page">

                    <div class="container">

                        <!-- BACK -->

                        <a href="/locations" class="simple-location-back">

                            ← Back to Locations

                        </a>


                        <!-- LOCATION CARD -->

                        <article class="simple-location-show-card">

                            <div class="simple-location-show-top">

                                <h1>
                                    <%= location.name %>
                                </h1>


                                <span class="location-status location-status-js"
                                    data-opening="<%= location.openingTime %>"
                                    data-closing="<%= location.closingTime %>">
                                </span>

                            </div>


                            <!-- INFORMATION -->

                            <div class="simple-location-show-info">

                                <div>

                                    <span>
                                        Address
                                    </span>

                                    <strong>
                                        <%= location.address %>,
                                            <%= location.city %>
                                    </strong>

                                </div>


                                <div>

                                    <span>
                                        Opening Hours
                                    </span>

                                    <strong>
                                        <%= location.openingTime %>
                                            –
                                            <%= location.closingTime %>
                                    </strong>

                                </div>


                                <div>

                                    <span>
                                        Phone
                                    </span>

                                    <strong>
                                        <%= location.phone %>
                                    </strong>

                                </div>

                            </div>

                        </article>

                    </div>

                </main>


                <!-- CUSTOMER / ANONYMOUS FOOTER -->

                <%- include('../partials/_footer.ejs') %>


                    <% } %>


                        <!-- ============================================
     OPEN / CLOSED STATUS
============================================ -->
                        <script>
                            function convertToMinutes(time) {
                                if (!time) return null;

                                time = time.trim().toLowerCase();

                                const match = time.match(
                                    /^(\d{1,2})(?::(\d{2}))?\s*(am|pm)$/
                                );

                                if (match) {
                                    let hours = parseInt(match[1]);
                                    const minutes = parseInt(match[2]) || 0;
                                    const period = match[3];

                                    if (period === "am" && hours === 12) {
                                        hours = 0;
                                    }

                                    if (period === "pm" && hours !== 12) {
                                        hours += 12;
                                    }

                                    return hours * 60 + minutes;
                                }

                                const parts = time.split(":");

                                const hours = parseInt(parts[0]);
                                const minutes = parseInt(parts[1]) || 0;

                                if (isNaN(hours)) return null;

                                return hours * 60 + minutes;
                            }


                            function updateLocationStatus() {

                                const now = new Date();

                                const current =
                                    now.getHours() * 60 +
                                    now.getMinutes();


                                document
                                    .querySelectorAll(".location-status-js")
                                    .forEach(status => {

                                        const opening =
                                            convertToMinutes(
                                                status.dataset.opening
                                            );

                                        const closing =
                                            convertToMinutes(
                                                status.dataset.closing
                                            );


                                        if (opening === null || closing === null) {
                                            status.textContent = "Closed";
                                            return;
                                        }


                                        let isOpen = false;


                                        // Normal hours
                                        // Example: 8am → 8pm
                                        if (opening < closing) {

                                            isOpen =
                                                current >= opening &&
                                                current < closing;

                                        }


                                        // Overnight hours
                                        // Example: 9am → 12am
                                        else if (opening > closing) {

                                            isOpen =
                                                current >= opening ||
                                                current < closing;

                                        }


                                        // Same opening and closing time
                                        else {

                                            isOpen = false;

                                        }


                                        status.textContent =
                                            isOpen ? "Open" : "Closed";


                                        status.classList.remove(
                                            "location-open",
                                            "location-closed"
                                        );


                                        status.classList.add(
                                            isOpen
                                                ? "location-open"
                                                : "location-closed"
                                        );

                                    });
                            }


                            updateLocationStatus();

                            // Update every minute
                            setInterval(updateLocationStatus, 60000);
                        </script>


</body>

</html>