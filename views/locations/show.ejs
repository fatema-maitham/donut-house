<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        <%= location.name %> | Donut House
    </title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;600;700;800;900&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body>

    <%- include('../partials/_navbar.ejs') %>


        <main class="simple-location-show-page">

            <div class="container">

                <a href="/locations" class="simple-location-back">
                    ← Back to Locations
                </a>


                <article class="simple-location-show-card">


                    <div class="simple-location-show-top">

                        <h1>
                            <%= location.name %>
                        </h1>

                        <% const now=new Date(); const currentMinutes=now.getHours() * 60 + now.getMinutes(); const
                            [openHour, openMinute]=location.openingTime.split(':').map(Number); const [closeHour,
                            closeMinute]=location.closingTime.split(':').map(Number); const openingMinutes=openHour * 60
                            + openMinute; const closingMinutes=closeHour * 60 + closeMinute; const isOpen=openingMinutes
                            <=closingMinutes ? currentMinutes>= openingMinutes &&
                            currentMinutes < closingMinutes : currentMinutes>= openingMinutes ||
                                currentMinutes < closingMinutes; %>

                                    <span class="location-status <%= isOpen ? 'location-open' : 'location-closed' %>">
                                        <%= isOpen ? 'Open' : 'Closed' %>
                                    </span>

                    </div>


                    <div class="simple-location-show-info">

                        <div>
                            <span>
                                Address
                            </span>

                            <strong>
                                <%= location.address %>, <%= location.city %>
                            </strong>
                        </div>

                        <div>
                            <span>
                                Opening Hours
                            </span>

                            <strong>
                                <%= location.openingTime %>
                                    –
                                    <%= location.closingTime %>
                            </strong>
                        </div>

                        <div>
                            <span>
                                Phone
                            </span>

                            <strong>
                                <%= location.phone %>
                            </strong>
                        </div>

                    </div>


                    <% if (user && user.role==='admin' ) { %>

                        <div class="simple-location-show-actions">

                            <a href="/locations/<%= location._id %>/edit" class="simple-location-button">
                                Edit Location
                            </a>

                            <form action="/locations/<%= location._id %>?_method=DELETE" method="POST"
                                onsubmit="return confirm('Are you sure you want to delete this location?');">

                                <button type="submit" class="simple-location-delete">
                                    Delete Location
                                </button>

                            </form>

                        </div>

                        <% } %>

                </article>

            </div>

        </main>


        <%- include('../partials/_footer.ejs') %>

</body>

</html>