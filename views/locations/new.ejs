<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Add Location - Donut House</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;600;700;800;900&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body>

    <%- include('../partials/_navbar.ejs') %>

        <div class="admin-layout">

            <%- include('../partials/_adminSidebar.ejs') %>

                <main class="admin-content">

                    <div class="admin-form-card">

                        <h1>Add Location</h1>

                        <p class="admin-form-subtitle">
                            Add a new Donut House location.
                        </p>

                        <form action="/locations" method="POST" class="admin-form">

                            <label for="name">
                                Location Name
                            </label>

                            <input type="text" id="name" name="name" placeholder="e.g. Seef District" required>

                            <label for="address">
                                Address
                            </label>

                            <input type="text" id="address" name="address" placeholder="Enter address" required>

                            <label for="openingTime">
                                Opening Time
                            </label>

                            <input type="text" id="openingTime" name="openingTime" placeholder="9:00 AM" required>

                            <label for="closingTime">
                                Closing Time
                            </label>

                            <input type="text" id="closingTime" name="closingTime" placeholder="10:00 PM" required>

                            <button type="submit" class="admin-button">
                                Add Location
                            </button>

                        </form>

                    </div>

                </main>

        </div>

        <%- include('../partials/_footer.ejs') %>

</body>

</html>