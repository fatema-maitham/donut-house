<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Locations | Donut House</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;600;700;800;900&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body>

    <% if (user && user.role==='admin' ) { %>

        <div class="admin-layout">

            <%- include('../partials/_adminSidebar.ejs') %>

                <main class="admin-content">

                    <div class="admin-page-header">

                        <div>


                            <h1>
                                Locations
                            </h1>

                            <p>
                                Manage your pickup locations.
                            </p>
                        </div>

                        <a href="/locations/new" class="admin-button admin-button-link">
                            Add Location
                        </a>

                    </div>


                    <% if (locations.length===0) { %>

                        <div class="simple-location-empty">

                            <h2>
                                No locations yet
                            </h2>

                            <p>
                                Add your first pickup location.
                            </p>

                            <a href="/locations/new" class="simple-location-button">
                                Add Location
                            </a>

                        </div>

                        <% } else { %>

                            <div class="simple-location-list">

                                <% locations.forEach(location=> { %>

                                    <article class="simple-location-card">

                                        <div class="simple-location-top">

                                            <div>



                                                <h2>
                                                    <%= location.name %>
                                                </h2>

                                            </div>

                                            <span class="location-status location-status-js"
                                                data-opening="<%= location.openingTime %>"
                                                data-closing="<%= location.closingTime %>">
                                            </span>


                                        </div>

                                        <p>
                                            <strong>Address:</strong>
                                            <%= location.address %>, <%= location.city %>
                                        </p>

                                        <p>
                                            <strong>Hours:</strong>
                                            <%= location.openingTime %> – <%= location.closingTime %>
                                        </p>

                                        <p>
                                            <strong>Phone:</strong>
                                            <%= location.phone %>
                                        </p>

                                        <div class="simple-location-actions">

                                            <a href="/locations/<%= location._id %>" class="simple-location-button">
                                                View
                                            </a>

                                            <a href="/locations/<%= location._id %>/edit" class="simple-location-edit">
                                                Edit
                                            </a>

                                            <form action="/locations/<%= location._id %>?_method=DELETE" method="POST"
                                                onsubmit="return confirm('Delete this location?');">

                                                <button type="submit" class="simple-location-delete">
                                                    Delete
                                                </button>

                                            </form>

                                        </div>


                                    </article>

                                    <% }) %>

                            </div>

                            <% } %>

                </main>

        </div>

        <% } else { %>

            <%- include('../partials/_navbar.ejs') %>

                <main class="simple-locations-page">

                    <div class="container">

                        <div class="simple-locations-header">


                            <h1>
                                Locations
                            </h1>

                            <p>
                                Find your nearest Donut House.
                            </p>

                        </div>


                        <% if (locations.length===0) { %>

                            <div class="simple-location-empty">

                                <h2>
                                    No locations available
                                </h2>

                                <p>
                                    Check back soon for a Donut House near you.
                                </p>

                            </div>

                            <% } else { %>

                                <div class="simple-location-list">

                                    <% locations.forEach(location=> { %>

                                        <article class="simple-location-card">

                                            <div class="simple-location-top">

                                                <div>



                                                    <h2>
                                                        <%= location.name %>
                                                    </h2>

                                                </div>

                                                <span class="location-status location-status-js"
                                                    data-opening="<%= location.openingTime %>"
                                                    data-closing="<%= location.closingTime %>">
                                                </span>


                                            </div>

                                            <p>
                                                <strong>Address:</strong>
                                                <%= location.address %>, <%= location.city %>
                                            </p>

                                            <p>
                                                <strong>Hours:</strong>
                                                <%= location.openingTime %> – <%= location.closingTime %>
                                            </p>

                                            <p>
                                                <strong>Phone:</strong>
                                                <%= location.phone %>
                                            </p>

                                            <a href="/locations/<%= location._id %>" class="simple-location-button">
                                                View Location
                                            </a>

                                        </article>

                                        <% }) %>

                                </div>

                                <% } %>

                    </div>

                </main>
                <%- include('../partials/_footer.ejs') %>

                    <% } %>
                        <script>
                            function convertToMinutes(time) {
                                if (!time) return null;

                                time = time.trim().toLowerCase();

                                const match = time.match(
                                    /^(\d{1,2})(?::(\d{2}))?\s*(am|pm)$/
                                );

                                if (match) {
                                    let hours = parseInt(match[1]);
                                    const minutes = parseInt(match[2]) || 0;
                                    const period = match[3];

                                    if (period === "am" && hours === 12) {
                                        hours = 0;
                                    }

                                    if (period === "pm" && hours !== 12) {
                                        hours += 12;
                                    }

                                    return hours * 60 + minutes;
                                }

                                const parts = time.split(":");

                                const hours = parseInt(parts[0]);
                                const minutes = parseInt(parts[1]) || 0;

                                if (isNaN(hours)) return null;

                                return hours * 60 + minutes;
                            }


                            function updateLocationStatus() {

                                const now = new Date();

                                const current =
                                    now.getHours() * 60 +
                                    now.getMinutes();


                                document
                                    .querySelectorAll(".location-status-js")
                                    .forEach(status => {

                                        const opening =
                                            convertToMinutes(
                                                status.dataset.opening
                                            );

                                        const closing =
                                            convertToMinutes(
                                                status.dataset.closing
                                            );


                                        if (opening === null || closing === null) {
                                            status.textContent = "Closed";
                                            return;
                                        }


                                        let isOpen = false;


                                        // Normal hours
                                        // Example: 8am → 8pm
                                        if (opening < closing) {

                                            isOpen =
                                                current >= opening &&
                                                current < closing;

                                        }


                                        // Overnight hours
                                        // Example: 9am → 12am
                                        else if (opening > closing) {

                                            isOpen =
                                                current >= opening ||
                                                current < closing;

                                        }


                                        // Same opening and closing time
                                        else {

                                            isOpen = false;

                                        }


                                        status.textContent =
                                            isOpen ? "Open" : "Closed";


                                        status.classList.remove(
                                            "location-open",
                                            "location-closed"
                                        );


                                        status.classList.add(
                                            isOpen
                                                ? "location-open"
                                                : "location-closed"
                                        );

                                    });
                            }


                            updateLocationStatus();

                            // Update every minute
                            setInterval(updateLocationStatus, 60000);
                        </script>


</body>

</html>