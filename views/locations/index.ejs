<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Locations - Donut House</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;600;700;800;900&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body>

    <%- include('../partials/_navbar.ejs') %>

        <div class="admin-layout">

            <%- include('../partials/_adminSidebar.ejs') %>

                <main class="admin-content">

                    <div class="admin-page-header">

                        <div>
                            <h1>Locations</h1>

                            <p>
                                Manage Donut House locations.
                            </p>
                        </div>

                        <a href="/locations/new" class="admin-button admin-button-link">
                            Add Location
                        </a>

                    </div>


                    <div class="admin-cards">

                        <% locations.forEach(location=> { %>

                            <div class="admin-card">

                                <h2>
                                    <%= location.name %>
                                </h2>

                                <p>
                                    <strong>Address:</strong>
                                    <%= location.address %>
                                </p>

                                <p>
                                    <strong>Opening:</strong>
                                    <%= location.openingTime %>
                                </p>

                                <p>
                                    <strong>Closing:</strong>
                                    <%= location.closingTime %>
                                </p>

                            </div>

                            <% }) %>

                    </div>

                </main>

        </div>

        <%- include('../partials/_footer.ejs') %>

</body>

</html>