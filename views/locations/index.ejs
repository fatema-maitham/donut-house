<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Locations | Donut House</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;600;700;800;900&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body>

    <% if (user && user.role==='admin' ) { %>

        <!-- =========================
             ADMIN LOCATIONS
        ========================== -->

        <div class="admin-layout">

            <%- include('../partials/_adminSidebar.ejs') %>

                <main class="admin-content">

                    <div class="admin-page-header">

                        <div>
                            <span class="location-label">
                                DONUT HOUSE
                            </span>

                            <h1>
                                Locations
                            </h1>

                            <p>
                                Manage your Donut House pickup locations.
                            </p>
                        </div>

                        <a href="/locations/new" class="admin-button admin-button-link">
                            Add Location
                        </a>

                    </div>


                    <% if (locations.length===0) { %>

                        <div class="admin-empty">

                            <h2>
                                No locations yet
                            </h2>

                            <p>
                                Add your first Donut House pickup location.
                            </p>

                            <a href="/locations/new" class="admin-button admin-button-link">
                                Add Location
                            </a>

                        </div>

                        <% } else { %>

                            <div class="location-admin-grid">

                                <% locations.forEach(location=> { %>

                                    <article class="location-admin-card">

                                        <div class="location-card-top">

                                            <div>

                                                <span class="location-label">
                                                    DONUT HOUSE
                                                </span>

                                                <h2>
                                                    <%= location.name %>
                                                </h2>

                                            </div>

                                            <span
                                                class="location-status <%= location.available ? 'location-open' : 'location-closed' %>">

                                                <%= location.available ? 'Open' : 'Closed' %>

                                            </span>

                                        </div>


                                        <div class="location-admin-info">

                                            <div class="location-admin-row">

                                                <span class="location-admin-icon">
                                                    📍
                                                </span>

                                                <div>

                                                    <strong>
                                                        Address
                                                    </strong>

                                                    <p>
                                                        <%= location.address %>,
                                                            <%= location.city %>
                                                    </p>

                                                </div>

                                            </div>


                                            <div class="location-admin-row">

                                                <span class="location-admin-icon">
                                                    🕐
                                                </span>

                                                <div>

                                                    <strong>
                                                        Opening Hours
                                                    </strong>

                                                    <p>
                                                        <%= location.openingTime %>
                                                            –
                                                            <%= location.closingTime %>
                                                    </p>

                                                </div>

                                            </div>


                                            <div class="location-admin-row">

                                                <span class="location-admin-icon">
                                                    ☎
                                                </span>

                                                <div>

                                                    <strong>
                                                        Phone
                                                    </strong>

                                                    <p>
                                                        <%= location.phone %>
                                                    </p>

                                                </div>

                                            </div>

                                        </div>


                                        <div class="location-card-actions">

                                            <a href="/locations/<%= location._id %>" class="location-view-btn">
                                                View
                                            </a>

                                            <a href="/locations/<%= location._id %>/edit" class="location-edit-btn">
                                                Edit
                                            </a>

                                            <form action="/locations/<%= location._id %>?_method=DELETE" method="POST"
                                                onsubmit="return confirm('Delete this location?');">

                                                <button type="submit" class="location-delete-btn">
                                                    Delete
                                                </button>

                                            </form>

                                        </div>

                                    </article>

                                    <% }) %>

                            </div>

                            <% } %>

                </main>

        </div>


        <% } else { %>

            <!-- =========================
             CUSTOMER LOCATIONS
        ========================== -->

            <%- include('../partials/_navbar.ejs') %>

                <main class="locations-page">

                    <section class="locations-section">

                        <div class="container">

                            <% if (locations.length===0) { %>

                                <div class="locations-empty">

                                    <h2>
                                        No locations available
                                    </h2>

                                    <p>
                                        Check back soon for a Donut House near you.
                                    </p>

                                </div>

                                <% } else { %>

                                    <div class="locations-grid">

                                        <% locations.forEach(location=> { %>

                                            <article class="location-card">

                                                <div class="location-card-header">

                                                    <div>

                                                        <span class="location-label">
                                                            DONUT HOUSE
                                                        </span>

                                                        <h2>
                                                            <%= location.name %>
                                                        </h2>

                                                    </div>

                                                    <span class="location-status location-status-js"
                                                        data-opening="<%= location.openingTime %>"
                                                        data-closing="<%= location.closingTime %>">

                                                    </span>

                                                </div>


                                                <div class="location-details">

                                                    <!-- ADDRESS -->

                                                    <div class="location-detail">

                                                        <span class="location-detail-icon">
                                                            📍
                                                        </span>

                                                        <div>

                                                            <span class="location-detail-title">
                                                                Address
                                                            </span>

                                                            <p>
                                                                <%= location.address %>,
                                                                    <%= location.city %>
                                                            </p>

                                                        </div>

                                                    </div>


                                                    <!-- HOURS -->

                                                    <div class="location-detail">

                                                        <span class="location-detail-icon">
                                                            🕐
                                                        </span>

                                                        <div>

                                                            <span class="location-detail-title">
                                                                Opening Hours
                                                            </span>

                                                            <p>
                                                                <%= location.openingTime %>
                                                                    –
                                                                    <%= location.closingTime %>
                                                            </p>

                                                        </div>

                                                    </div>


                                                    <!-- PHONE -->

                                                    <div class="location-detail">

                                                        <span class="location-detail-icon">
                                                            ☎
                                                        </span>

                                                        <div>

                                                            <span class="location-detail-title">
                                                                Phone
                                                            </span>

                                                            <p>
                                                                <%= location.phone %>
                                                            </p>

                                                        </div>

                                                    </div>

                                                </div>


                                                <a href="/locations/<%= location._id %>" class="location-card-button">

                                                    View Location

                                                    <span>
                                                        →
                                                    </span>

                                                </a>

                                            </article>

                                            <% }) %>

                                    </div>

                                    <% } %>

                        </div>

                    </section>

                </main>

                <% } %>


                    <!-- =========================
         OPEN / CLOSED
    ========================== -->

                    <script>

                        function convertToMinutes(time) {

                            if (!time) return null;

                            time = time.trim().toUpperCase();

                            let hours;
                            let minutes;

                            if (time.includes("AM") || time.includes("PM")) {

                                const parts = time.split(" ");

                                const clock = parts[0];
                                const period = parts[1];

                                const clockParts = clock.split(":");

                                hours = parseInt(clockParts[0]);
                                minutes = parseInt(clockParts[1]) || 0;

                                if (period === "PM" && hours !== 12) {
                                    hours += 12;
                                }

                                if (period === "AM" && hours === 12) {
                                    hours = 0;
                                }

                            } else {

                                const parts = time.split(":");

                                hours = parseInt(parts[0]);
                                minutes = parseInt(parts[1]) || 0;

                            }

                            return (hours * 60) + minutes;
                        }


                        document.querySelectorAll(".location-status-js")
                            .forEach(status => {

                                const opening =
                                    convertToMinutes(
                                        status.dataset.opening
                                    );

                                const closing =
                                    convertToMinutes(
                                        status.dataset.closing
                                    );

                                const now = new Date();

                                const current =
                                    (now.getHours() * 60) +
                                    now.getMinutes();


                                let isOpen = false;


                                if (opening <= closing) {

                                    isOpen =
                                        current >= opening &&
                                        current < closing;

                                } else {

                                    // Handles hours that pass midnight

                                    isOpen =
                                        current >= opening ||
                                        current < closing;

                                }


                                if (isOpen) {

                                    status.textContent = "Open";

                                    status.classList.add("location-open");

                                    status.classList.remove("location-closed");

                                } else {

                                    status.textContent = "Closed";

                                    status.classList.add("location-closed");

                                    status.classList.remove("location-open");

                                }

                            });

                    </script>

</body>

</html>